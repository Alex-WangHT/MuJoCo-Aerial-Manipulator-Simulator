<mujoco model="multirotor_platform">
  <!--
    六旋翼多旋翼平台（Multirotor）。

    约定（供 src/Multirotor.py 按名称自省）：
    - 机体 body:          drone
    - 自由关节:           drone_free
    - IMU site:           imu_site（gyro / accelerometer / magnetometer 挂载点）
    - 机械臂挂载点 site:   manipulator_mount（AerialManipulator 以此为固连位置 attach 机械臂）
    - 旋翼 actuator:      rotor1 .. rotor6（site 传动，gear 含 Z 轴反扭矩，相邻旋翼符号交替）
    - 旋翼 site:          rotorN_site（位于各机臂末端）

    注意：本文件只描述机器人本体，不含地板/灯光/障碍物等场景元素；
    场景由 models/environment.xml 提供（src/Environment.py 组合）。
  -->
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <asset>
    <material name="drone_mat" rgba="0.12 0.16 0.20 1"/>
  </asset>

  <worldbody>
    <body name="drone" pos="0 0 1.5">
      <freejoint name="drone_free"/>

      <!-- IMU 与机械臂挂载点（机体系） -->
      <site name="imu_site" pos="0 0 0" size="0.008" rgba="0 1 0 1"/>
      <site name="manipulator_mount" pos="0 0 -0.05" size="0.01" rgba="1 0.5 0 1"/>

      <!-- 机身：三块交叉面板 + 六条机臂 -->
      <geom name="drone_panel_1" type="box" pos="0 0 0" euler="0 0 0" size="0.155 0.090 0.04" material="drone_mat" mass="0.50"/>
      <geom name="drone_panel_2" type="box" pos="0 0 0" euler="0 0 1.0471975512" size="0.155 0.090 0.04" material="drone_mat" mass="0.50"/>
      <geom name="drone_panel_3" type="box" pos="0 0 0" euler="0 0 -1.0471975512" size="0.155 0.090 0.04" material="drone_mat" mass="0.50"/>
      <geom name="rotor1_arm" type="capsule" fromto="0 0 0 0.34 0 0" size="0.015" material="drone_mat" mass="0.03"/>
      <geom name="rotor2_arm" type="capsule" fromto="0 0 0 0.17 0.294 0" size="0.015" material="drone_mat" mass="0.03"/>
      <geom name="rotor3_arm" type="capsule" fromto="0 0 0 -0.17 0.294 0" size="0.015" material="drone_mat" mass="0.03"/>
      <geom name="rotor4_arm" type="capsule" fromto="0 0 0 -0.34 0 0" size="0.015" material="drone_mat" mass="0.03"/>
      <geom name="rotor5_arm" type="capsule" fromto="0 0 0 -0.17 -0.294 0" size="0.015" material="drone_mat" mass="0.03"/>
      <geom name="rotor6_arm" type="capsule" fromto="0 0 0 0.17 -0.294 0" size="0.015" material="drone_mat" mass="0.03"/>

      <body name="rotor1_body" pos="0.34 0 0">
        <site name="rotor1_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
      <body name="rotor2_body" pos="0.17 0.294 0">
        <site name="rotor2_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
      <body name="rotor3_body" pos="-0.17 0.294 0">
        <site name="rotor3_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
      <body name="rotor4_body" pos="-0.34 0 0">
        <site name="rotor4_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
      <body name="rotor5_body" pos="-0.17 -0.294 0">
        <site name="rotor5_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
      <body name="rotor6_body" pos="0.17 -0.294 0">
        <site name="rotor6_site" pos="0 0 0" size="0.01"/>
        <geom type="cylinder" size="0.07 0.005" rgba="0.08 0.08 0.08 1" mass="0.01"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- gear = [Fx Fy Fz Tx Ty Tz]：Z 升力 + Z 反扭矩，奇偶旋翼反扭矩反向（模拟正/反转桨） -->
    <motor name="rotor1" site="rotor1_site" gear="0 0 1 0 0 0.02" ctrlrange="0 12"/>
    <motor name="rotor2" site="rotor2_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 12"/>
    <motor name="rotor3" site="rotor3_site" gear="0 0 1 0 0 0.02" ctrlrange="0 12"/>
    <motor name="rotor4" site="rotor4_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 12"/>
    <motor name="rotor5" site="rotor5_site" gear="0 0 1 0 0 0.02" ctrlrange="0 12"/>
    <motor name="rotor6" site="rotor6_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 12"/>
  </actuator>

  <sensor>
    <!-- 机体 IMU（以后对接 PX4 HITL 也靠这两个） -->
    <gyro name="gyro" site="imu_site"/>
    <accelerometer name="accel" site="imu_site"/>
    <magnetometer name="mag" site="imu_site"/>
    <!-- MJCF 无 barometer 元素；气压高度可由 drone_pos 的 Z 分量换算 -->
    <!-- 机体全局位姿 -->
    <framepos name="drone_pos" objtype="body" objname="drone"/>
    <framequat name="drone_quat" objtype="body" objname="drone"/>
    <!-- 挂载点全局位姿（验证机械臂固连位置用） -->
    <framepos name="mount_pos" objtype="site" objname="manipulator_mount"/>
    <framequat name="mount_quat" objtype="site" objname="manipulator_mount"/>
  </sensor>
</mujoco>
