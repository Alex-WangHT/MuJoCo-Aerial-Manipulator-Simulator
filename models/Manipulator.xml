<mujoco model="manipulator_3dof">
  <!--
    三自由度机械臂（Manipulator）：基座回转 + 肩俯仰 + 肘俯仰。

    本文件是“子模型”：由 AerialManipulator 通过 mjSpec.attach 挂到
    multirotor.xml 的 manipulator_mount site 上，attach 后所有名称带前缀（默认 arm/）。

    网格、运动学链与惯性参数来自开源 SO-ARM100 机械臂（TheRobotStudio，
    Apache-2.0，经 MuJoCo Menagerie 的 trs_so_arm100 模型整理；
    许可证见 models/assets/so_arm100/LICENSE）。本模型取其前三个关节链
    （Rotation / Pitch / Elbow），去除腕部与夹爪；末端 ee_site 位于原腕部连接点。
    零位姿态为臂自然下垂（配合 manipulator_mount 的挂载翻转，见 multirotor.xml）。

    约定（供 src/Manipulator.py 按名称/前缀自省）：
    - 关节:       joint1（基座回转）/ joint2（肩俯仰）/ joint3（肘俯仰）
    - 舵机:       与关节同名（<position joint="jointN">）
    - 末端 site:   ee_site
    - 传感器:     jointposN / jointvelN / ee_pos / ee_quat

    注意：作为子模型不要声明 <option>/<size> 或地板/灯光——编译时以父模型为准。
  -->
  <compiler angle="radian" meshdir="assets/so_arm100"/>

  <asset>
    <material name="arm_white" rgba="1 1 1 1"/>
    <material name="arm_black" rgba="0.1 0.1 0.1 1"/>
    <mesh name="Base" file="Base.stl"/>
    <mesh name="Base_Motor" file="Base_Motor.stl"/>
    <mesh name="Rotation_Pitch" file="Rotation_Pitch.stl"/>
    <mesh name="Rotation_Pitch_Motor" file="Rotation_Pitch_Motor.stl"/>
    <mesh name="Upper_Arm" file="Upper_Arm.stl"/>
    <mesh name="Upper_Arm_Motor" file="Upper_Arm_Motor.stl"/>
    <mesh name="Lower_Arm" file="Lower_Arm.stl"/>
    <mesh name="Lower_Arm_Motor" file="Lower_Arm_Motor.stl"/>
  </asset>

  <default>
    <default class="arm3dof">
      <!-- SO-ARM100 官方参数：关节摩擦/电枢与舵机刚度 -->
      <joint frictionloss="0.1" armature="0.1"/>
      <position kp="50" dampratio="1" forcerange="-3.5 3.5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" material="arm_white"/>
        <default class="motor_visual">
          <geom material="arm_black"/>
        </default>
      </default>
      <default class="collision">
        <geom group="3" type="mesh" material="arm_white"/>
      </default>
    </default>
  </default>

  <worldbody>
    <!-- 基座：显式惯性（网格实体体积密度 1000 会高估质量；实际为空心注塑壳 + 舵机）。
         euler 使零位姿态（原模型中臂水平 -Y 微抬）整体旋转为自然下垂（-Z）。 -->
    <body name="Base" euler="1.8596 0 0" childclass="arm3dof">
      <inertial pos="0 0 0.025" mass="0.1" diaginertia="8e-5 8e-5 8e-5"/>
      <geom type="mesh" mesh="Base" class="visual"/>
      <geom type="mesh" mesh="Base_Motor" class="motor_visual"/>
      <geom name="base_geom" type="mesh" mesh="Base" class="collision"/>
      <body name="Rotation_Pitch" pos="0 -0.0452 0.0165" quat="0.707105 0.707108 0 0">
        <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504"
          mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05"/>
        <joint name="joint1" axis="0 1 0" range="-1.92 1.92"/>
        <geom type="mesh" mesh="Rotation_Pitch" class="visual"/>
        <geom type="mesh" mesh="Rotation_Pitch_Motor" class="motor_visual"/>
        <geom name="rotation_geom" type="mesh" mesh="Rotation_Pitch" class="collision"/>
        <body name="Upper_Arm" pos="0 0.1025 0.0306" euler="1.57079 0 0">
          <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632"
            mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05"/>
          <joint name="joint2" axis="1 0 0" range="-3.32 0.174"/>
          <geom type="mesh" mesh="Upper_Arm" class="visual"/>
          <geom type="mesh" mesh="Upper_Arm_Motor" class="motor_visual"/>
          <geom name="upper_geom" type="mesh" mesh="Upper_Arm" class="collision"/>
          <body name="Lower_Arm" pos="0 0.11257 0.028" euler="-1.57079 0 0">
            <inertial pos="-0.00339604 0.00137796 0.0768007" quat="0.701995 0.0787996 0.0645626 0.704859"
              mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05"/>
            <joint name="joint3" axis="1 0 0" range="-0.174 3.14"/>
            <geom type="mesh" mesh="Lower_Arm" class="visual"/>
            <geom type="mesh" mesh="Lower_Arm_Motor" class="motor_visual"/>
            <geom name="lower_geom" type="mesh" mesh="Lower_Arm" class="collision"/>
            <!-- 末端执行器：原 SO-ARM100 腕部连接点 -->
            <site name="ee_site" pos="0 0.0052 0.1349" euler="-1.57079 0 0" size="0.008" rgba="1 0 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 位置舵机：ctrl = 目标关节角 [rad]；class 继承 kp/dampratio/forcerange -->
    <position class="arm3dof" name="joint1" joint="joint1" inheritrange="1"/>
    <position class="arm3dof" name="joint2" joint="joint2" inheritrange="1"/>
    <position class="arm3dof" name="joint3" joint="joint3" inheritrange="1"/>
  </actuator>

  <sensor>
    <jointpos name="jointpos1" joint="joint1"/>
    <jointpos name="jointpos2" joint="joint2"/>
    <jointpos name="jointpos3" joint="joint3"/>
    <jointvel name="jointvel1" joint="joint1"/>
    <jointvel name="jointvel2" joint="joint2"/>
    <jointvel name="jointvel3" joint="joint3"/>
    <framepos name="ee_pos" objtype="site" objname="ee_site"/>
    <framequat name="ee_quat" objtype="site" objname="ee_site"/>
  </sensor>

  <contact>
    <exclude body1="Base" body2="Rotation_Pitch"/>
  </contact>
</mujoco>
